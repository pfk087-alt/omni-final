# OpenAI (opcional para la importación del catálogo; requerido por los agentes)
OPENAI_API_KEY=
OPENAI_REWRITE_MODEL=gpt-5.4-mini

# Supabase: ejecuta data/supabase-schema.sql una vez en el SQL Editor.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Necesaria para que el cron escriba en la tabla desde el servidor. Nunca usar NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Amazon Associates Creators API (requiere acceso aprobado)
AMAZON_AFFILIATE_TAG=kevinpatane20-21
# TODO: pega aquí el identificador de afiliado de Amazon.es, por ejemplo mi-tienda-21.
AMAZON_CREATOR_API_CLIENT_ID=
AMAZON_CREATOR_API_CLIENT_SECRET=
AMAZON_MARKETPLACE=www.amazon.es

# Vercel Cron: define un secreto aleatorio de al menos 16 caracteres en Production.
CRON_SECRET=

# Shopify Custom App (solo para el importador del panel Auto Store)
SHOPIFY_STORE_DOMAIN=tu-tienda.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
